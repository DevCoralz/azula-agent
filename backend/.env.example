# ---------- Server ----------
PORT=8000
NODE_ENV=production
# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:8080,https://your-frontend.onrender.com

# ---------- Database (MySQL 8) ----------
DATABASE_URL=mysql://azula:change-me@127.0.0.1:3306/azula

# ---------- Security ----------
# Long random string. Generate with: openssl rand -hex 48
JWT_SECRET=replace-with-64-random-hex-chars
# 32-byte key, hex encoded (64 chars). Encrypts user API keys at rest.
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-chars
# This email becomes admin automatically when it registers
ADMIN_EMAIL=you@example.com

# ---------- Workspaces ----------
# Directory where every user workspace is created
WORKSPACES_ROOT=/var/lib/azula/workspaces
# process = run commands as child processes of this server (simple, use on a dedicated box)
# docker  = run each workspace in its own container (recommended for public hosting)
SANDBOX_MODE=process
SANDBOX_IMAGE=azula/sandbox:latest
SANDBOX_MEMORY=1g
SANDBOX_CPUS=1
SANDBOX_PIDS=256

# ---------- Agent ----------
AGENT_MAX_STEPS=40
EXEC_TIMEOUT_SECONDS=180
EXEC_OUTPUT_LIMIT=20000

# ---------- Live preview ----------
PREVIEW_PORT_START=9100
PREVIEW_PORT_END=9199
# {port} is replaced with the allocated port. Use your VPS host or a reverse proxy.
PREVIEW_URL_TEMPLATE=http://localhost:{port}
